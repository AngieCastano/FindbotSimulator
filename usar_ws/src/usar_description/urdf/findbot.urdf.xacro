<?xml version="1.0"?>
<!--
  Robot diferencial "findbot" para búsqueda de víctimas (Capa 2).
  Pose planar χ = [x, y, θ]ᵀ; todos los parámetros se leen de config/robot.yaml.

  Árbol de frames:
    base_footprint → base_link → {left_wheel_link, right_wheel_link, caster_link,
                                  lidar_link, camera_link → camera_optical_frame,
                                  [thermal_link → thermal_optical_frame], [co2_link],
                                  [mic_array_link]}
  Los sensores de la fase 2 solo se incluyen con use_thermal:=true / use_co2:=true /
  use_sound:=true / use_radar:=true.
  sim_pose:=true añade la pose real del robot (/sim/ground_truth/odom) para los simuladores de
  sensores de usar_sim_sensors (excepción del ground truth, ver CLAUDE.md); el robot no la usa.
-->
<robot name="findbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="robot_params" default="$(find usar_description)/config/robot.yaml"/>
  <xacro:arg name="use_thermal" default="false"/>
  <xacro:arg name="use_co2" default="false"/>
  <xacro:arg name="use_sound" default="false"/>
  <xacro:arg name="use_radar" default="false"/>
  <xacro:arg name="sim_pose" default="false"/>
  <xacro:property name="p" value="${xacro.load_yaml('$(arg robot_params)')}"/>
  <xacro:property name="ch" value="${p['chassis']}"/>
  <xacro:property name="wh" value="${p['wheels']}"/>
  <xacro:property name="cs" value="${p['caster']}"/>
  <xacro:property name="dd" value="${p['diff_drive']}"/>
  <xacro:property name="ld" value="${p['lidar']}"/>
  <xacro:property name="cam" value="${p['camera']}"/>
  <xacro:property name="th" value="${p['thermal']}"/>
  <xacro:property name="co2" value="${p['co2']}"/>
  <xacro:property name="mic" value="${p['mic_array']}"/>
  <xacro:property name="rad" value="${p['radar']}"/>

  <!-- ===================== Macros de inercia ===================== -->
  <xacro:macro name="box_inertia" params="m x y z ox:=0">
    <inertial>
      <origin xyz="${ox} 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m * (y*y + z*z) / 12}" ixy="0" ixz="0"
               iyy="${m * (x*x + z*z) / 12}" iyz="0" izz="${m * (x*x + y*y) / 12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m * (3*r*r + h*h) / 12}" ixy="0" ixz="0"
               iyy="${m * (3*r*r + h*h) / 12}" iyz="0" izz="${m * r * r / 2}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${2 * m * r * r / 5}" ixy="0" ixz="0"
               iyy="${2 * m * r * r / 5}" iyz="0" izz="${2 * m * r * r / 5}"/>
    </inertial>
  </xacro:macro>

  <!-- ===================== Materiales (RViz) ===================== -->
  <material name="findbot_blue"><color rgba="0.12 0.37 0.75 1"/></material>
  <material name="findbot_black"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="findbot_grey"><color rgba="0.6 0.6 0.6 1"/></material>

  <!-- ===================== Cuerpo ===================== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wh['radius']}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="${ch['x_offset']} 0 ${ch['z_offset']}"/>
      <geometry><box size="${ch['length']} ${ch['width']} ${ch['height']}"/></geometry>
      <material name="findbot_blue"/>
    </visual>
    <collision>
      <origin xyz="${ch['x_offset']} 0 ${ch['z_offset']}"/>
      <geometry><box size="${ch['length']} ${ch['width']} ${ch['height']}"/></geometry>
    </collision>
    <xacro:box_inertia m="${ch['mass']}" x="${ch['length']}" y="${ch['width']}"
                       z="${ch['height']}" ox="${ch['x_offset']}"/>
  </link>

  <!-- ===================== Ruedas motrices ===================== -->
  <xacro:macro name="wheel" params="side y_sign">
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <!-- roll -π/2: el eje z de la rueda apunta a +y; giro positivo = avance -->
      <!-- base_link está sobre el eje de ruedas: es el centro de giro del robot diferencial,
           como suponen la odometría y Nav2. -->
      <origin xyz="0 ${y_sign * wh['separation'] / 2} 0"
              rpy="${-pi / 2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <link name="${side}_wheel_link">
      <visual>
        <geometry><cylinder radius="${wh['radius']}" length="${wh['width']}"/></geometry>
        <material name="findbot_black"/>
      </visual>
      <!-- Colisión esférica: el contacto cilindro-plano de Gazebo se produce en el borde
           interior de la rueda, lo que reduce la separación efectiva (~13 %) y hace que la
           odometría subestime los giros. Con una esfera el contacto queda en el plano medio. -->
      <collision>
        <geometry><sphere radius="${wh['radius']}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${wh['mass']}" r="${wh['radius']}" h="${wh['width']}"/>
    </link>
    <gazebo reference="${side}_wheel_link">
      <mu1>${wh['friction']}</mu1>
      <mu2>${wh['friction']}</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:wheel side="left" y_sign="1"/>
  <xacro:wheel side="right" y_sign="-1"/>

  <!-- ===================== Rueda loca ===================== -->
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${cs['x_offset']} 0 ${cs['radius'] - wh['radius']}"/>
  </joint>
  <link name="caster_link">
    <visual>
      <geometry><sphere radius="${cs['radius']}"/></geometry>
      <material name="findbot_grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="${cs['radius']}"/></geometry>
    </collision>
    <xacro:sphere_inertia m="${cs['mass']}" r="${cs['radius']}"/>
  </link>
  <gazebo reference="caster_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- ===================== LiDAR 2D ===================== -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${ld['x']} 0 ${ld['z']}"/>
  </joint>
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="findbot_black"/>
    </visual>
    <xacro:cylinder_inertia m="0.1" r="0.035" h="0.04"/>
  </link>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <gz_frame_id>lidar_link</gz_frame_id>
      <topic>/scan</topic>
      <update_rate>${ld['update_rate']}</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>${ld['samples']}</samples>
            <resolution>1</resolution>
            <min_angle>${-pi}</min_angle>
            <max_angle>${pi - 2 * pi / ld['samples']}</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>${ld['min_range']}</min>
          <max>${ld['max_range']}</max>
          <resolution>${ld['range_resolution']}</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>${ld['noise_stddev']}</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ===================== Cámara RGB-D ===================== -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${cam['x']} 0 ${cam['z']}" rpy="0 ${cam['pitch']} 0"/>
  </joint>
  <link name="camera_link">
    <visual>
      <geometry><box size="0.02 0.09 0.03"/></geometry>
      <material name="findbot_black"/>
    </visual>
    <xacro:box_inertia m="0.05" x="0.02" y="0.09" z="0.03"/>
  </link>

  <!-- Frame óptico (convención ROS: z adelante, x derecha, y abajo) -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi / 2} 0 ${-pi / 2}"/>
  </joint>
  <link name="camera_optical_frame"/>

  <gazebo reference="camera_link">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <topic>/camera</topic>
      <update_rate>${cam['update_rate']}</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>${cam['horizontal_fov']}</horizontal_fov>
        <image>
          <width>${cam['width']}</width>
          <height>${cam['height']}</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>${cam['near']}</near>
          <far>${cam['far']}</far>
        </clip>
        <depth_camera>
          <clip>
            <near>${cam['near']}</near>
            <far>${cam['far']}</far>
          </clip>
        </depth_camera>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>${cam['noise_stddev']}</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- ===================== Cámara térmica (fase 2) ===================== -->
  <!-- Gazebo publica la imagen cruda (mono16, 0.01 K por unidad) en /sim/thermal/image_raw;
       usar_sim_sensors/thermal_camera_sim añade el ruido del MLX90640 y publica /thermal/image
       en °C. (El sensor térmico de Gazebo no admite <noise>: hace fallar al servidor.) -->
  <xacro:if value="$(arg use_thermal)">
    <joint name="thermal_joint" type="fixed">
      <parent link="base_link"/>
      <child link="thermal_link"/>
      <origin xyz="${th['x']} ${th['y']} ${th['z']}" rpy="0 ${th['pitch']} 0"/>
    </joint>
    <link name="thermal_link">
      <visual>
        <geometry><box size="0.01 0.02 0.02"/></geometry>
        <material name="findbot_black"/>
      </visual>
      <xacro:box_inertia m="0.005" x="0.01" y="0.02" z="0.02"/>
    </link>
    <joint name="thermal_optical_joint" type="fixed">
      <parent link="thermal_link"/>
      <child link="thermal_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi / 2} 0 ${-pi / 2}"/>
    </joint>
    <link name="thermal_optical_frame"/>

    <gazebo reference="thermal_link">
      <sensor name="thermal_camera" type="thermal">
        <gz_frame_id>thermal_optical_frame</gz_frame_id>
        <topic>/sim/thermal/image_raw</topic>
        <update_rate>${th['update_rate']}</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>${th['horizontal_fov']}</horizontal_fov>
          <image>
            <width>${th['width']}</width>
            <height>${th['height']}</height>
            <format>L16</format>
          </image>
          <clip>
            <near>${th['near']}</near>
            <far>${th['far']}</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:if>

  <!-- ===================== Sensor de CO₂ (fase 2) ===================== -->
  <!-- Gazebo no modela gases: la medida la genera usar_sim_sensors/co2_sim en este frame. -->
  <xacro:if value="$(arg use_co2)">
    <joint name="co2_joint" type="fixed">
      <parent link="base_link"/>
      <child link="co2_link"/>
      <origin xyz="${co2['x']} ${co2['y']} ${co2['z']}" rpy="0 0 0"/>
    </joint>
    <link name="co2_link">
      <visual>
        <geometry><cylinder radius="0.01" length="0.016"/></geometry>
        <material name="findbot_black"/>
      </visual>
      <xacro:box_inertia m="0.005" x="0.02" y="0.02" z="0.016"/>
    </link>
  </xacro:if>

  <!-- ===================== Arreglo de micrófonos (fase 2) ===================== -->
  <!-- Gazebo no modela sonido: la dirección de llegada la genera usar_sim_sensors/sound_sim. -->
  <xacro:if value="$(arg use_sound)">
    <joint name="mic_array_joint" type="fixed">
      <parent link="base_link"/>
      <child link="mic_array_link"/>
      <origin xyz="${mic['x']} ${mic['y']} ${mic['z']}" rpy="0 0 0"/>
    </joint>
    <link name="mic_array_link">
      <visual>
        <geometry><cylinder radius="0.035" length="0.01"/></geometry>
        <material name="findbot_black"/>
      </visual>
      <xacro:box_inertia m="0.02" x="0.07" y="0.07" z="0.01"/>
    </link>
  </xacro:if>

  <!-- ===================== Radar Doppler HB100 (fase 2) ===================== -->
  <!-- Gazebo no modela radar: la señal IF la genera usar_sim_sensors/radar_sim (antena hacia +x). -->
  <xacro:if value="$(arg use_radar)">
    <joint name="radar_joint" type="fixed">
      <parent link="base_link"/>
      <child link="radar_link"/>
      <origin xyz="${rad['x']} ${rad['y']} ${rad['z']}" rpy="0 0 0"/>
    </joint>
    <link name="radar_link">
      <visual>
        <geometry><box size="0.01 0.048 0.046"/></geometry>
        <material name="findbot_black"/>
      </visual>
      <xacro:box_inertia m="0.01" x="0.01" y="0.048" z="0.046"/>
    </link>
  </xacro:if>

  <!-- Pose real del robot en el mundo, SOLO para los simuladores de sensores de la Capa 2. -->
  <xacro:if value="$(arg sim_pose)">
    <gazebo>
      <plugin filename="gz-sim-odometry-publisher-system"
              name="gz::sim::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <odom_topic>/sim/ground_truth/odom</odom_topic>
        <odom_publish_frequency>20</odom_publish_frequency>
        <dimensions>2</dimensions>
      </plugin>
    </gazebo>
  </xacro:if>

  <!-- ===================== Plugins de Gazebo Harmonic ===================== -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wh['separation']}</wheel_separation>
      <wheel_radius>${wh['radius']}</wheel_radius>
      <max_linear_velocity>${dd['max_linear_velocity']}</max_linear_velocity>
      <min_linear_velocity>${-dd['max_linear_velocity']}</min_linear_velocity>
      <max_angular_velocity>${dd['max_angular_velocity']}</max_angular_velocity>
      <min_angular_velocity>${-dd['max_angular_velocity']}</min_angular_velocity>
      <max_linear_acceleration>${dd['max_linear_acceleration']}</max_linear_acceleration>
      <min_linear_acceleration>${-dd['max_linear_acceleration']}</min_linear_acceleration>
      <max_angular_acceleration>${dd['max_angular_acceleration']}</max_angular_acceleration>
      <min_angular_acceleration>${-dd['max_angular_acceleration']}</min_angular_acceleration>
      <odom_publish_frequency>${dd['odom_publish_frequency']}</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <!-- Odometría ideal de los encoders (incluye el patinaje real). La lee solo
           usar_sim_sensors/odom_noise_sim, que añade el ruido de los encoders y publica
           /odom y la TF odom → base_footprint. Su TF no se puentea a ROS. -->
      <odom_topic>/sim/wheel_odom</odom_topic>
      <tf_topic>/sim/wheel_odom/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

</robot>
