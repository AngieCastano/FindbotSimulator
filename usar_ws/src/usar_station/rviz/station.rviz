# RViz de la estación remota: solo lo que llega por el enlace (/station/*); la TF se
# remapea a /station/tf en station.launch.py. "2D Goal Pose" envía /station/goal_pose.
Panels:
- Class: rviz_common/Displays
  Help Height: 0
  Name: Displays
  Property Tree Widget:
    Expanded: null
    Splitter Ratio: 0.5
  Tree Height: 300
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Reference Frame: <Fixed Frame>
    Cell Size: 1
    Plane Cell Count: 30
    Color: 160; 160; 164
    Alpha: 0.5
    Value: true
  - Class: rviz_default_plugins/Map
    Name: Mapa (SLAM)
    Enabled: true
    Topic:
      Value: /station/map
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
    Color Scheme: map
    Alpha: 0.9
    Draw Behind: true
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Name: Victimas detectadas
    Enabled: true
    Topic:
      Value: /station/victims/markers
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Namespaces: {}
    Value: true
  - Class: rviz_default_plugins/RobotModel
    Name: RobotModel
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
    Visual Enabled: true
    Collision Enabled: false
    Value: true
  - Class: rviz_default_plugins/LaserScan
    Name: LaserScan
    Enabled: true
    Topic:
      Value: /station/scan
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
    Style: Flat Squares
    Size (m): 0.05
    Color Transformer: FlatColor
    Color: 255; 40; 40
    Alpha: 1
    Decay Time: 0
    Value: true
  - Class: rviz_default_plugins/Image
    Name: Camara del robot
    Enabled: true
    Topic:
      Value: /station/camera/image
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
    Normalize Range: true
    Value: true
  - Class: rviz_default_plugins/Image
    Name: Termica (deteccion)
    Enabled: true
    Topic:
      Value: /station/thermal/debug_image
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
    Normalize Range: true
    Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/Measure
  - Class: rviz_default_plugins/SetInitialPose
    Topic:
      Value: /initialpose
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Value: /station/goal_pose
  - Class: rviz_default_plugins/PublishPoint
    Topic:
      Value: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: base_footprint
      Distance: 12
      Pitch: 1.2
      Yaw: 3.6
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Near Clip Distance: 0.01
      Value: Orbit (rviz)
    Saved: null
Window Geometry:
  Height: 900
  Width: 1400
  Hide Left Dock: false
  Hide Right Dock: true
  Camara (deteccion):
    collapsed: false
  Displays:
    collapsed: false
